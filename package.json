{
  "name": "poker-night",
  "version": "1.0.0",
  "description": "Multiplayer Texas Hold'em for friends: rooms by code, accounts, persistent chips",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "sandbox": "node server.js --sandbox --open",
    "sandbox:reset": "node -e \"require('fs').rmSync('sandbox-data',{recursive:true,force:true});console.log('Sandbox data deleted')\"",
    "build:offline": "node scripts/build-offline.js",
    "test": "node --test test/*.test.js"
  },
